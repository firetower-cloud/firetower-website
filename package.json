{
  "name": "firetower-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "node --experimental-strip-types --test scripts/downloads.test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "prebuild": "node scripts/build-docs-index.mjs && node scripts/build-docs-markdown.mjs",
    "sync:downloads": "node --experimental-strip-types scripts/sync-downloads.mjs",
    "predev": "node scripts/build-docs-index.mjs && node scripts/build-docs-markdown.mjs",
    "check:app-links": "node scripts/check-app-doc-links.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "@types/mdx": "^2.0.14",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5"
  }
}
