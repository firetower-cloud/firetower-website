{
  "hosting": {
    "//": "The deploy names a target rather than a site: `firebase deploy --only hosting:prod`. Without this key that target resolves to nothing and the deploy stops with \"Hosting site or target prod not detected\". `.firebaserc` maps prod to the usefiretower-prod site.",
    "target": "prod",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/install.sh",
        "destination": "https://github.com/firetower-cloud/firetower/releases/download/worker-latest/install.sh",
        "type": 302
      },
      {
        "source": "/worker.sh",
        "destination": "https://github.com/firetower-cloud/firetower/releases/download/worker-latest/worker.sh",
        "type": 302
      },
      {
        "source": "/docs/self-host",
        "destination": "/docs/architecture",
        "type": 301
      },
      {
        "source": "/docs/domain",
        "destination": "/docs/install-firetower",
        "type": 301
      },
      {
        "source": "/docs/self-hosting/domain",
        "destination": "/docs/install-firetower",
        "type": 301
      },
      {
        "source": "/docs/hosts",
        "destination": "/docs/machines",
        "type": 301
      },
      {
        "source": "/docs/operations",
        "destination": "/docs/architecture",
        "type": 301
      },
      {
        "source": "/docs/self-hosting/operations",
        "destination": "/docs/architecture",
        "type": 301
      },
      {
        "source": "/docs/repositories",
        "destination": "/docs/repo-setup",
        "type": 301
      },
      {
        "source": "/docs/secrets",
        "destination": "/docs/data",
        "type": 301
      },
      {
        "source": "/docs/self-hosting/install",
        "destination": "/docs/install-firetower",
        "type": 301
      },
      {
        "source": "/docs/self-hosting/machines",
        "destination": "/docs/machines",
        "type": 301
      },
      {
        "source": "/docs/self-hosting/app/upgrade",
        "destination": "/docs/updates",
        "type": 301
      },
      {
        "source": "/docs/self-hosting/machines/upgrade",
        "destination": "/docs/updates",
        "type": 301
      },
      {
        "source": "/docs/self-hosting",
        "destination": "/docs/architecture",
        "type": 301
      },
      {
        "source": "/docs/self-hosting/app/install",
        "destination": "/docs/install-firetower",
        "type": 301
      },
      {
        "source": "/docs/self-hosting/machines/install",
        "destination": "/docs/machines",
        "type": 301
      },
      {
        "source": "/docs/connect-github",
        "destination": "/docs/git",
        "type": 301
      },
      {
        "source": "/docs/getting-started",
        "destination": "/docs/join",
        "type": 301
      },
      {
        "source": "/docs/permissions/people",
        "destination": "/docs/people",
        "type": 301
      },
      {
        "source": "/docs/permissions/sharing",
        "destination": "/docs/sharing",
        "type": 301
      },
      {
        "source": "/docs/permissions/workspaces",
        "destination": "/docs/workspaces",
        "type": 301
      },
      {
        "source": "/docs/organise",
        "destination": "/docs/sharing",
        "type": 301
      },
      {
        "source": "/docs/update",
        "destination": "/docs/updates",
        "type": 301
      },
      {
        "//": "Use a fresh canonical URL so previously cached /docs/install redirects cannot form a loop.",
        "source": "/docs/install",
        "destination": "/docs/install-firetower",
        "type": 301
      },
      {
        "source": "/docs/networking",
        "destination": "/docs/install-firetower",
        "type": 301
      },
      {
        "source": "/docs/worker-help",
        "destination": "/docs/machines",
        "type": 301
      },
      {
        "source": "/docs/recipes",
        "destination": "/docs/runs",
        "type": 301
      },
      {
        "source": "/docs/cli",
        "destination": "/docs/install-firetower",
        "type": 301
      },
      {
        "source": "/docs/capacity",
        "destination": "/docs/requirements",
        "type": 301
      },
      {
        "source": "/docs/mobile",
        "destination": "/docs/join",
        "type": 301
      },
      {
        "source": "/docs/offboarding",
        "destination": "/docs/people",
        "type": 301
      },
      {
        "source": "/docs/identity",
        "destination": "/docs/people",
        "type": 301
      }
    ],
    "headers": [
      {
        "//": "Metadata images use stable URLs. Serve PNG and revalidate after an hour so a brand update does not remain cached for a year.",
        "source": "/@(opengraph-image|twitter-image|apple-icon|icon)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "/enterprise/@(opengraph-image|twitter-image)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "//": "Next fingerprints everything under _next/static, so these URLs can never change contents.",
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "//": "Public assets keep stable filenames, so revalidate them after an hour. Only _next/static assets are content-addressed.",
        "source": "**/*.@(woff|woff2|ttf|otf|eot|png|jpg|jpeg|gif|webp|avif|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "//": "The demo recording. Nothing under public/ is fingerprinted by the build, so the cut number lives in the filename instead \u2014 re-cutting the demo means publishing demo-1.0.* and pointing DemoVideo.tsx at it, never overwriting these bytes. Accept-Ranges so the browser can seek without refetching the file.",
        "source": "**/*.@(mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Accept-Ranges",
            "value": "bytes"
          }
        ]
      },
      {
        "//": "HTML and the metadata text files must revalidate, or a deploy would not be visible until caches expire.",
        "source": "**/*.@(html|xml|txt|webmanifest|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/docs-search.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/docs/**/*.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Link",
            "value": "</llms.txt>; rel=\"describedby\""
          }
        ]
      },
      {
        "source": "/enterprise.md",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "Link",
            "value": "</llms.txt>; rel=\"describedby\""
          }
        ]
      },
      {
        "//": "Baseline hosting headers.",
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      }
    ]
  }
}
